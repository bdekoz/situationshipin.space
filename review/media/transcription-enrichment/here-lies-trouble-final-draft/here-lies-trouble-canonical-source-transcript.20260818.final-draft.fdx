    <Paragraph Type="Dialogue">
      <Text>this is not</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>UNKNOWN SPEAKER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>a truth about Kim from Miss Saigon.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>SPEAKER 1</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Oh, yeah, yeah, that sounded amazing. Oh my gosh, yeah.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>UNKNOWN SPEAKER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Tell Benjamin three historically Asian characters.</Text>
